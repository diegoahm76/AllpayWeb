-- =========================================
-- 1) TRM
-- =========================================
CREATE TABLE IF NOT EXISTS public.trm (
    idregistro      integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    fecha_registro  date NOT NULL,
    precio_trm      integer NOT NULL,
    anio            integer GENERATED ALWAYS AS (EXTRACT(YEAR FROM fecha_registro)::int) STORED,
    mes             integer GENERATED ALWAYS AS (EXTRACT(MONTH FROM fecha_registro)::int) STORED,
    usuario_que_registra_id integer NOT NULL,
    CONSTRAINT trm_usuario_fk
        FOREIGN KEY (usuario_que_registra_id)
        REFERENCES public.auth_user(id)
        ON DELETE CASCADE
);

-- Index de ordenamiento sugerido en el modelo
CREATE INDEX IF NOT EXISTS trm_fecha_registro_idx ON public.trm (fecha_registro DESC);

COMMENT ON TABLE public.trm IS 'TRM diaria';
COMMENT ON COLUMN public.trm.usuario_que_registra_id IS 'Usuario que registra (FK a auth_user)';

-- =========================================
-- 2) Bolsa NY
-- =========================================
CREATE TABLE IF NOT EXISTS public.bolsa_ny (
    idregistro      integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    idusuario_id    integer NOT NULL, -- Usuario que registra
    fecha_registro  date NOT NULL,
    anio            integer GENERATED ALWAYS AS (EXTRACT(YEAR FROM fecha_registro)::int) STORED,
    mes             integer GENERATED ALWAYS AS (EXTRACT(MONTH FROM fecha_registro)::int) STORED,
    precio_cierre   integer NOT NULL,
    CONSTRAINT bolsa_ny_usuario_fk
        FOREIGN KEY (idusuario_id)
        REFERENCES public.auth_user(id)
        ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS bolsa_ny_fecha_registro_idx ON public.bolsa_ny (fecha_registro DESC);

COMMENT ON TABLE public.bolsa_ny IS 'Precio de cierre Bolsa de Nueva York';
COMMENT ON COLUMN public.bolsa_ny.idusuario_id IS 'Usuario que registra (FK a auth_user)';

-- =========================================
-- 3) Department (reportes_department)
--    code y name como en el modelo (enteros y texto)
-- =========================================
CREATE TABLE IF NOT EXISTS public.reportes_department (
    code integer PRIMARY KEY,   -- DPTO_CCDGO (ej. 18, 5)
    name varchar(100) NOT NULL  -- DPTO_CNMBR
);

CREATE INDEX IF NOT EXISTS reportes_department_name_idx ON public.reportes_department (name);

COMMENT ON TABLE public.reportes_department IS 'Catálogo de departamentos (para reportes).';

-- =========================================
-- 4) Municipality (reportes_municipality)
--    FK a reportes_department(code)
--    unique_code = department.code * 1000 + code
-- =========================================
CREATE TABLE IF NOT EXISTS public.reportes_municipality (
    DPTO_CCDGO integer NOT NULL,                        -- FK a reportes_department.code
    code       integer NOT NULL,                        -- MPIO_CCDGO
    name       varchar(120) NOT NULL,                   -- MPIO_CNMBR
    unique_code integer GENERATED ALWAYS AS ((DPTO_CCDGO * 1000) + code) STORED,
    CONSTRAINT reportes_municipality_pk PRIMARY KEY (DPTO_CCDGO, code),
    CONSTRAINT reportes_municipality_department_fk
        FOREIGN KEY (DPTO_CCDGO)
        REFERENCES public.reportes_department(code)
        ON DELETE RESTRICT,
    CONSTRAINT uniq_municipality_per_department UNIQUE (DPTO_CCDGO, code)
);

-- Índices según el modelo
CREATE INDEX IF NOT EXISTS reportes_municipality_depto_code_idx ON public.reportes_municipality (DPTO_CCDGO, code);
CREATE INDEX IF NOT EXISTS reportes_municipality_name_idx       ON public.reportes_municipality (name);
CREATE INDEX IF NOT EXISTS reportes_municipality_unique_code_idx ON public.reportes_municipality (unique_code);

COMMENT ON TABLE public.reportes_municipality IS 'Municipios (para reportes).';
COMMENT ON COLUMN public.reportes_municipality.unique_code IS 'DPTO_CCDGO * 1000 + MPIO_CCDGO';

-- =========================================
-- 5) ProduccionCacaoHistorico
--    pano generado como suma de meses (COALESCE a 0)
-- =========================================
CREATE TABLE IF NOT EXISTS public."ProduccionCacaoHistorico" (
    ano integer PRIMARY KEY,
    enero      numeric(10,3),
    febrero    numeric(10,3),
    marzo      numeric(10,3),
    abril      numeric(10,3),
    mayo       numeric(10,3),
    junio      numeric(10,3),
    julio      numeric(10,3),
    agosto     numeric(10,3),
    septiembre numeric(10,3),
    octubre    numeric(10,3),
    noviembre  numeric(10,3),
    diciembre  numeric(10,3),
    pano       numeric(12,3) GENERATED ALWAYS AS (
        (COALESCE(enero,0) + COALESCE(febrero,0) + COALESCE(marzo,0) + COALESCE(abril,0) +
         COALESCE(mayo,0)  + COALESCE(junio,0)   + COALESCE(julio,0) + COALESCE(agosto,0) +
         COALESCE(septiembre,0) + COALESCE(octubre,0) + COALESCE(noviembre,0) + COALESCE(diciembre,0))
    ) STORED
);

-- Única en ano (ya es PK)
-- Índice de ordenamiento opcional (descendente)
CREATE INDEX IF NOT EXISTS prod_cacao_historico_ano_desc_idx ON public."ProduccionCacaoHistorico" (ano DESC);

COMMENT ON TABLE public."ProduccionCacaoHistorico" IS 'Histórico de producción de cacao por año y mes.';
COMMENT ON COLUMN public."ProduccionCacaoHistorico".pano IS 'Total anual (suma de meses).';

-- =========================================
-- 6) ProduccionDepartamentoAnual
--    CodDepartamento (varchar(2)/text) FK a DepartamentosPais.cod_departamento
-- =========================================
CREATE TABLE IF NOT EXISTS public."ProduccionDepartamentoAnual" (
    "CodDepartamento" varchar(2) NOT NULL,
    ano integer NOT NULL,
    produccion numeric(14,3) NOT NULL, -- "Producción (toneladas)"
    CONSTRAINT ProduccionDepartamentoAnual_pk PRIMARY KEY ("CodDepartamento", ano),
    CONSTRAINT uq_prod_dep_ano UNIQUE ("CodDepartamento", ano),
    CONSTRAINT prod_dep_anual_departamento_fk
        FOREIGN KEY ("CodDepartamento")
        REFERENCES public."DepartamentosPais"("cod_departamento")
        ON DELETE RESTRICT
);

-- Índices solicitados
CREATE INDEX IF NOT EXISTS prod_dep_anual_ano_idx ON public."ProduccionDepartamentoAnual" (ano);
CREATE INDEX IF NOT EXISTS prod_dep_anual_dep_ano_idx ON public."ProduccionDepartamentoAnual" ("CodDepartamento", ano);

COMMENT ON TABLE public."ProduccionDepartamentoAnual" IS 'Producción anual por departamento (cód. DANE 2 dígitos).';

-- Asegura PK en Modulos("IdModulo")
DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM information_schema.table_constraints
        WHERE table_schema='public' AND table_name='Modulos' AND constraint_type='PRIMARY KEY'
    ) THEN
        ALTER TABLE public."Modulos"
        ADD CONSTRAINT modulos_pkey PRIMARY KEY ("IdModulo");
    END IF;
END$$;

-- FKs desde ConfiguracionClasesAlerta a Modulos
ALTER TABLE public."ConfiguracionClasesAlerta"
    ADD CONSTRAINT "fk_conf_alerta_mod_destino"
    FOREIGN KEY ("Id_ModuloDestino") REFERENCES public."Modulos" ("IdModulo")
    ON UPDATE CASCADE ON DELETE SET NULL;

ALTER TABLE public."ConfiguracionClasesAlerta"
    ADD CONSTRAINT "fk_conf_alerta_mod_generador"
    FOREIGN KEY ("Id_ModuloGenerador") REFERENCES public."Modulos" ("IdModulo")
    ON UPDATE CASCADE ON DELETE SET NULL;


ALTER TABLE public."ConfiguracionClasesAlerta" OWNER TO postgres;

--
-- TOC entry 308 (class 1259 OID 20922)
-- Name: CuotasAcuerdoPago; Type: TABLE; Schema: public; Owner: postgres
--

-- TRM (tasa representativa del mercado)
CREATE TABLE IF NOT EXISTS public.trm (
    idregistro SERIAL PRIMARY KEY,
    fecha_registro DATE NOT NULL,
    precio_trm INTEGER NOT NULL,
    anio INTEGER NOT NULL,
    mes INTEGER NOT NULL,
    usuario_que_registra INTEGER NOT NULL REFERENCES public."Usuarios" ("IdUsuario") ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_trm_fecha ON public.trm (fecha_registro);
CREATE UNIQUE INDEX IF NOT EXISTS uq_trm_fecha ON public.trm (fecha_registro);

-- Bolsa de Nueva York (precios)
CREATE TABLE IF NOT EXISTS public.bolsa_ny (
    idregistro SERIAL PRIMARY KEY,
    idusuario_id INTEGER NOT NULL REFERENCES public."Usuarios" ("IdUsuario") ON DELETE CASCADE,
    fecha_registro DATE NOT NULL,
    anio INTEGER NOT NULL,
    mes SMALLINT NOT NULL,
    precio_cierre INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_bolsany_fecha ON public.bolsa_ny (fecha_registro);
DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM pg_constraint
        WHERE conname = 'uq_bolsany_fecha' AND conrelid = 'bolsa_ny'::regclass
    ) THEN
        ALTER TABLE public.bolsa_ny ADD CONSTRAINT uq_bolsany_fecha UNIQUE (fecha_registro);
    END IF;
END$$;


-- Bórrala si existe con DDL erróneo (solo si ya probaste antes)
-- DROP TABLE IF EXISTS public."ProduccionDepartamentoAnual" CASCADE;

CREATE TABLE IF NOT EXISTS public."ProduccionDepartamentoAnual" (
  idregistro       SERIAL PRIMARY KEY,
  "CodDepartamento" VARCHAR(2) NOT NULL,   -- mismo tipo que la tabla referenciada
  ano             INTEGER     NOT NULL,
  produccion      INTEGER     NOT NULL,

  CONSTRAINT uq_prod_dep_ano UNIQUE ("CodDepartamento", ano),
  CONSTRAINT prod_dep_anual_departamento_fk
    FOREIGN KEY ("CodDepartamento")
    REFERENCES public."DepartamentosPais"("CodDepartamento")
    ON DELETE RESTRICT
);
-- si

-- Índices útiles
CREATE INDEX IF NOT EXISTS idx_pda_ano
  ON public."ProduccionDepartamentoAnual"(ano);

CREATE INDEX IF NOT EXISTS idx_pda_dep_ano
  ON public."ProduccionDepartamentoAnual"("CodDepartamento", ano);


