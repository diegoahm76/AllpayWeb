-- Ajusta el sequence para que el próximo nextval() sea MAX(IdUsuario)+1
SELECT setval(
  pg_get_serial_sequence('"Usuarios"', 'IdUsuario'),
  COALESCE((SELECT MAX("IdUsuario") FROM "Usuarios"), 1),
  true
);

